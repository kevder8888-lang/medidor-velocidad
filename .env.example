# Optional extra measurement nodes (JSON array).
# Each node must expose the same /api/measure/* routes as this app.
# Example:
# NEXT_PUBLIC_EXTRA_SERVERS=[{"id":"lima-1","name":"Nodo Lima","region":"Lima, PE","baseUrl":"https://measure-lima.example.com"}]
NEXT_PUBLIC_EXTRA_SERVERS=

# Google Maps (Maps Embed API).
# Local: copy to .env.local
# Vercel: Project → Settings → Environment Variables → Production/Preview
# Restrict the key to your domains (localhost + vercel.app).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
